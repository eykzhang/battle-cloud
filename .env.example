# API
PORT=8080
DATABASE_URL=postgres://battlecloud:battlecloud@postgres:5432/battlecloud
SHOWDOWN_BASE_URL=https://replay.pokemonshowdown.com/
REPLAY_MAX_BYTES=5242880
REPLAY_TIMEOUT_MS=20000
SUBMIT_RATE_LIMIT_PER_HOUR=20
# Must match the tag docker/worker.Dockerfile builds poke-engine from.
POKE_ENGINE_TAG=v0.0.48
# The month of the usage-stats file the worker image carries. Part of the analysis
# identity, and the value a worker filters its claims on.
USAGE_STATS_DATASET=2026-07

# Worker
# forever polls until killed, which is what compose and any always-on deployment want.
# drain claims until nothing is left for this build, then exits 0: the shape a task
# started per burst uses.
WORKER_MODE=forever
WORKER_CONCURRENCY=1
ENGINE_THREADS=4
# The directory that CONTAINS data/usage_stats, not that directory itself: the engine
# resolves Path("data/usage_stats") relative to the working directory.
ENGINE_DATA_DIR=/app
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3

# Postgres (compose only)
POSTGRES_USER=battlecloud
POSTGRES_PASSWORD=battlecloud
POSTGRES_DB=battlecloud
# Host port for the compose postgres. 5433 to avoid a local 5432 install.
POSTGRES_PORT=5433
